# College Football Swiss Tournament - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env file to git (it's in .gitignore)

# CFBD API Key
# Get your free API key at: https://collegefootballdata.com
# Free tier: 1,000 calls/month
CFBD_API_KEY=your_api_key_here

# Optional: Set log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# College Football Swiss - Environment Variables
# Copy this file to web/js/config.js and add your actual API keys

# Mapbox API Token
# Get yours at: https://account.mapbox.com/
# Free tier: 50,000 map loads/month
MAPBOX_TOKEN=your_mapbox_token_here
